{
  "functions": {
    "api/chess-voice-transcribe.js": {
      "maxDuration": 60
    },
    "api/coach-explanation.js": {
      "maxDuration": 20
    },
    "api/verify-paypal-subscription.js": {
      "maxDuration": 20
    },
    "api/paypal-webhook.js": {
      "maxDuration": 20
    },
    "api/image-to-position.js": {
      "maxDuration": 60
    },
    "api/lichess-games.js": {
      "maxDuration": 20
    },
    "api/cancel-paypal-subscription.js": {
      "maxDuration": 20
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/_route-metadata/home.html",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    },
    {
      "src": "/(auth|reset-password|account|onboarding|auto|sample-training|play-computer|play-vs-computer|book-trainer|analyze|board-vision-old|master-games-old)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/(free-play|analyze|master-games|book-trainer|play-computer|play-vs-computer|board-vision|endgame/piece-mates|endgame-studies)/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/(mates/m[1-8]|tactics/m[1-4])/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/_route-metadata/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    }
  ],
  "headers": [
    {
      "source": "/((?!pricing(?:/|$)).*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
